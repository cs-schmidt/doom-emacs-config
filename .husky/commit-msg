#!/usr/bin/env sh

# Runs after a commit message is entered, receiving the message file path as $1. Exits
# non-zero to abort the commit if the message fails validation.

# Executes the husky shell script.
. "$(dirname -- "$0")/_/husky.sh"

# Run commitlint against the commmit message.
npx --no -- commitlint --config .commitlintrc.yml --edit $1

